:8080 {
  redir / /default/ 302
  redir /claude /claude/
  redir /codex /codex/
  redir /default /default/

  handle / {
    root * /srv
    file_server
  }

  handle /claude/* {
    reverse_proxy 172.19.0.1:18084
  }

  handle /codex/* {
    reverse_proxy 172.19.0.1:18085
  }

  handle /default/* {
    reverse_proxy 172.19.0.1:18086
  }
}
