[Unit]
Description=Auto-restore Claw Remote tmux sessions after boot
After=openclaw-claw-claude.service openclaw-claw-codex.service openclaw-claw-default.service
Wants=openclaw-claw-claude.service openclaw-claw-codex.service openclaw-claw-default.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root
ExecStart=/bin/bash /root/.openclaw/skills/claw-remote/scripts/auto-restore-on-boot.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openclaw-claw-restore

[Install]
WantedBy=multi-user.target
