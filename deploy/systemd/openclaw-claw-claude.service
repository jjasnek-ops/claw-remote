[Unit]
Description=OpenClaw Claw Claude Control Backend
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root
ExecStartPre=/bin/bash /root/.openclaw/skills/coding-agent/scripts/clear-claw-port.sh 18084
ExecStart=/usr/bin/python3 /root/.openclaw/skills/coding-agent/scripts/claw-openclaw.py --tmux-socket /tmp/clawdbot-tmux-sockets/claude-code.sock --host 172.19.0.1 --port 18084 --refresh 3
Restart=always
RestartSec=5
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
